# Danko Music Converter — example environment file.
# Copy to ".env" and fill values locally. NEVER commit a real .env.
# All variables are OPTIONAL: the app runs fully offline without any of them.

# Optional: override the bundled FFmpeg binary with a local path.
# If unset, the app uses the FFmpeg bundled for the platform.
DANKO_FFMPEG=

# Optional: Spotify "Client ID" for metadata-only import (desktop OAuth with PKCE).
# This is a PUBLIC client id — there is NO client secret in this app.
# Leave empty to disable Spotify metadata import.
DANKO_SPOTIFY_CLIENT_ID=

# Development only (set automatically by `npm run dev`): renderer dev-server URL.
# DANKO_DEV_SERVER=
